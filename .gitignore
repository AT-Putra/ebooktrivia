# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# env & secrets (never commit)
.env
.env.*
!.env.example
infra/dev/.env
# The monitoring box's secrets (infra/monitoring, US-015): made on that box from the .example files, never committed.
infra/monitoring/glitchtip.env
infra/monitoring/glitchtip-db-password.txt
*.pem
*.key
*.p12
secrets/
infra/**/escrow/

# OMC transient state (plans/specs are kept). `**/` because hooks also create .omc/ in
# sub-package dirs when a command runs from there.
**/.omc/state/
**/.omc/drafts/
**/.omc/logs/
**/.omc/project-memory.json
**/.omc/sessions/
apps/**/.omc/
packages/**/.omc/

# test artifacts
playwright-report/
test-results/
load/results/
# Load-test working files: login tokens, session cookies and Cap tokens (infra/load/README.md). Never commit them.
infra/load/work/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# OMC ralph transient mirrors
.omc/prd.json
.omc/progress.txt
.omc/notepads/

# AI asset raw outputs (regenerate with pnpm assets)
tools/assets/raw/

# Security scan evidence (US-031; docs/runbooks/security-scans.md): reports of the staging scans, which can hold
# session ids, request bodies and page content. Never committed: only the scrubbed summary goes into the evidence.
zap-*/
headers-evidence/
