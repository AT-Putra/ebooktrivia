# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# env & secrets (never commit)
.env
.env.*
!.env.example
infra/dev/.env
*.pem
*.key
*.p12
secrets/
infra/**/escrow/

# OMC transient state (plans/specs are kept). `**/` because hooks also create .omc/ in
# sub-package dirs when a command runs from there.
**/.omc/state/
**/.omc/drafts/
**/.omc/logs/
**/.omc/project-memory.json
**/.omc/sessions/
apps/**/.omc/
packages/**/.omc/

# test artifacts
playwright-report/
test-results/
load/results/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# OMC ralph transient mirrors
.omc/prd.json
.omc/progress.txt
.omc/notepads/

# AI asset raw outputs (regenerate with pnpm assets)
tools/assets/raw/
