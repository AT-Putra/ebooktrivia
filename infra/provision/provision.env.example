# infra/provision configuration. Copy to /etc/ebooktrivia/provision.env (root:root, 0600) on the
# VM and replace EVERY value: the ones below are reserved example names (RFC 2606 .test) and
# documentation addresses (RFC 5737 / RFC 3849), not real ones. Format: KEY=value or KEY="a b";
# the file is parsed, never sourced. Lists are space-separated.

# Base domain: Caddy serves admin.<DOMAIN>, play.<DOMAIN>, order.<DOMAIN>, api.<DOMAIN>.
DOMAIN=staging.example.test

# ACME account contact for Let's Encrypt.
ACME_EMAIL=ops@example.test

# The existing non-root login (in group wheel, with ~/.ssh/authorized_keys) that keeps SSH access
# once root login and passwords are turned off. Provisioning refuses to touch sshd without it.
ADMIN_SSH_USER=opsadmin

# Sources allowed to reach SSH (port 22) through firewalld. Everyone else is dropped.
SSH_ALLOWED_CIDRS="192.0.2.0/24 2001:db8::/32"

# Sources allowed to reach admin.<DOMAIN> (Caddy answers 404 to anyone else). Include the
# Uptime Kuma host (plan M11). "0.0.0.0/0 ::/0" opens it to everyone.
ADMIN_ALLOWED_CIDRS="192.0.2.0/24"

# Sources allowed to POST the GlitchTip alert hook (the WAHA/GlitchTip box).
GLITCHTIP_ALLOWED_CIDRS="198.51.100.20/32"

# Sources allowed to POST the WAHA webhook (/api/v1/webhooks/waha: acks and buyer messages; Caddy answers 404 to anyone else, and the route also
# checks an HMAC). The WAHA servers' addresses as Caddy sees them: a WAHA on a public host is its public address, one that reaches Caddy over a private
# network is that network's address (docs/runbooks/delivery.md). "0.0.0.0/0 ::/0" leaves only the HMAC (not recommended).
WAHA_ALLOWED_CIDRS="198.51.100.20/32"

# Sources allowed to GET https://api.<DOMAIN>/healthz, the deep health of the public app (PostgreSQL, the worker heartbeat, Valkey; US-015):
# the Uptime Kuma host, which is the WAHA box (docs/runbooks/monitoring.md). Caddy answers 404 to anyone else. Put the SAME address in
# ADMIN_ALLOWED_CIDRS too: Kuma also checks admin.<DOMAIN>/healthz, and everyone outside ADMIN_ALLOWED_CIDRS gets a 404 there.
MONITOR_ALLOWED_CIDRS="198.51.100.20/32"

# Rootless podman user that runs every container (created if missing).
APP_USER=ebt
