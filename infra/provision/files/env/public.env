# /etc/ebooktrivia/public.env (0600, app user): public@a and public@b. Written by infra/provision:
# @GEN@ values are generated on the VM once and kept; a key already in the file keeps its value;
# lines the operator adds are kept. Non-secret settings (TRUSTED_PROXY_IP, EDGE_*) are in the quadlet.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL_PUBLIC=postgres://ebt_public:@GEN@@postgres:5432/ebooktrivia
VALKEY_URL=redis://valkey:6379
VALKEY_USERNAME=public
VALKEY_PASSWORD=@GEN@
# Checkout API (US-020, apps/public/src/lib/config.ts). DOMAIN: the Snap finish URL is
# https://order.<DOMAIN>/{publicId}.
DOMAIN=@DOMAIN@
# Signs the stateless Cap challenges and tokens (US-020); generated once, shared by public@a and public@b.
# Changing it voids every open challenge and token (buyers just solve a new one).
CAPTCHA_HMAC_KEY=@GEN@
# The PAYMENT private key only (base64url X25519), added by the Owner from escrow (provisioning does
# not generate it): it opens the sealed Midtrans server key. Without it checkout answers 503. The app
# refuses to start with any other scope's private key here.
#   SECRETS_PAYMENT_PRIVATE_KEY=<base64url>
