# /etc/ebooktrivia/admin.env (0600, app user): the admin app. Same rules as public.env.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL_ADMIN=postgres://ebt_admin:@GEN@@postgres:5432/ebooktrivia
VALKEY_URL=redis://valkey:6379
VALKEY_USERNAME=admin
VALKEY_PASSWORD=@GEN@
# The console's exact origin: every state-changing request must carry it as Origin (CSRF), and it
# is Better Auth's baseURL (apps/admin/src/lib/config.ts).
ADMIN_ORIGIN=https://admin.@DOMAIN@
# Better Auth's versioned secrets, newest first ("<version>:<secret>,..."): the first signs the
# session cookies and encrypts new TOTP secrets, older ones still decrypt. Rotate by putting a new
# version in front and keeping the old one (docs/runbooks/admin-access.md); removing a version
# makes the authenticators enrolled under it unreadable.
ADMIN_AUTH_SECRETS=1:@GEN@
# Settings (US-017, apps/admin/src/lib/settings/env.ts). DOMAIN: the LP snippet loads
# https://api.<DOMAIN>/sdk/v1.js and no landing-page domain may share its registrable domain.
DOMAIN=@DOMAIN@
# Ebook PDFs (<dir>/deliverables) and chunked-upload staging (<dir>/upload-staging); PDF hard cap.
ADMIN_DATA_DIR=/srv/data
ADMIN_PDF_MAX_BYTES=104857600
# Unfinished uploads at once per admin; staged bytes for all admins together, replaced PDFs not
# yet purged included (staging disk quota).
ADMIN_UPLOAD_MAX_OPEN_SESSIONS=3
ADMIN_UPLOAD_MAX_STAGED_BYTES=314572800
# Sealing keys: PUBLIC halves only (base64url X25519), added by the Owner from the escrowed key
# pairs (M4 escrow; provisioning does not generate them). Without them secret fields are disabled.
# The admin app refuses to start if any SECRETS_*_PRIVATE_KEY is present: it writes secrets, never
# reads them.
#   SECRETS_PAYMENT_PUBLIC_KEY=<base64url>
#   SECRETS_MESSAGING_PUBLIC_KEY=<base64url>
#   SECRETS_CONVERSIONS_PUBLIC_KEY=<base64url>
