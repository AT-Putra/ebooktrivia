# /etc/ebooktrivia/admin.env (0600, app user): the admin app. Same rules as public.env.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL_ADMIN=postgres://ebt_admin:@GEN@@postgres:5432/ebooktrivia
VALKEY_URL=redis://valkey:6379
VALKEY_USERNAME=admin
VALKEY_PASSWORD=@GEN@
# The console's exact origin: every state-changing request must carry it as Origin (CSRF), and it
# is Better Auth's baseURL (apps/admin/src/lib/config.ts).
ADMIN_ORIGIN=https://admin.@DOMAIN@
# Better Auth's versioned secrets, newest first ("<version>:<secret>,..."): the first signs the
# session cookies and encrypts new TOTP secrets, older ones still decrypt. Rotate by putting a new
# version in front and keeping the old one (docs/runbooks/admin-access.md); removing a version
# makes the authenticators enrolled under it unreadable.
ADMIN_AUTH_SECRETS=1:@GEN@
