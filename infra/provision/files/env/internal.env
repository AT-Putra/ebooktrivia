# /etc/ebooktrivia/internal.env (0600, app user): the internal process. Its environment is an
# allowlist (apps/worker/src/internal-config.ts): add nothing else here. GLITCHTIP_HOOK_TOKEN_SHA256
# is the SHA-256 of the hook token; the token itself is never stored here (rotation:
# infra/provision/rotate-glitchtip-token.sh). INTERNAL_HOST / INTERNAL_PORT are in the quadlet.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL_INTERNAL=postgres://ebt_internal:@GEN@@postgres:5432/ebooktrivia
GLITCHTIP_HOOK_TOKEN_SHA256=@GEN_TOKEN_SHA256@
