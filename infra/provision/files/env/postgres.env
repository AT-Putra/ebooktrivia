# /etc/ebooktrivia/postgres.env (0640 root:<app user>): read by the postgres image at first start
# (initdb). The superuser password is in /etc/ebooktrivia/postgres/superuser.pass, mounted at the
# path below, so it is in no container's environment; the superuser can only log in over the
# container's local socket anyway (pg_hba.conf).
POSTGRES_PASSWORD_FILE=/etc/postgresql/superuser.pass
POSTGRES_DB=ebooktrivia
