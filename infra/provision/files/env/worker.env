# /etc/ebooktrivia/worker.env (0640 root:<app user>): the worker (apps/worker/src/worker-config.ts).
# UPTIME_KUMA_PUSH_URL: the Uptime Kuma push monitor URL (https). Fill it in, or leave it empty
# (`UPTIME_KUMA_PUSH_URL=`) while there is no Kuma; host-check.sh fails while __SET_ME__ is left.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL_WORKER=postgres://ebt_worker:@GEN@@postgres:5432/ebooktrivia
VALKEY_URL=redis://valkey:6379
VALKEY_USERNAME=worker
VALKEY_PASSWORD=@GEN@
BULLMQ_PREFIX=ebt
UPTIME_KUMA_PUSH_URL=__SET_ME__
# Sealed-secret private keys (base64url X25519), added by the Owner from escrow (provisioning does
# not generate them). The messaging key opens the SMTP password and WAHA API keys (template
# test-sends, US-017; deliveries, US-025); without it template test-sends are not relayed.
#   SECRETS_MESSAGING_PRIVATE_KEY=<base64url>
# The login links a player asks for again on play.<DOMAIN>/masuk (US-027) point at https://play.<DOMAIN> too (DOMAIN, under
# Deliveries below); without it (or the messaging key) those requests wait in the outbox.
# The payment key opens the Midtrans server key: the worker re-queries Midtrans for every payment
# notification and runs the nightly reconciliation (US-021); without it no payment is confirmed.
#   SECRETS_PAYMENT_PRIVATE_KEY=<base64url>
# The conversions key opens the adnets' {secret:name} values and the CAPI access tokens of the landing
# pages' Meta / TikTok pixels: the worker sends the S2S postbacks, Meta CAPI and TikTok Events API
# conversions (US-024); without it no conversion is sent and the conversion.mo / order.paid rows wait.
#   SECRETS_CONVERSIONS_PRIVATE_KEY=<base64url>
# META_GRAPH_API_VERSION=v24.0   (the Graph API version of Meta CAPI requests; confirm it with the first real credentials)
# Deliveries (US-025). DOMAIN: the player's login link is https://play.<DOMAIN>/masuk#... and the ebook download URL WAHA fetches is
# https://api.<DOMAIN>/files/... (its signing key is derived from the payment private key above, which public.env holds too: deliveries
# need the messaging AND the payment key). The messaging key is what turns deliveries on. Optional, defaults in
# apps/worker/src/delivery/config.ts: WORKER_DATA_DIR=/srv/data, WORKER_DELIVERY_LEASE_MS=120000, WORKER_WAHA_TIMEOUT_MS=60000,
# WORKER_SMTP_TIMEOUT_MS=30000, WORKER_EMAIL_ATTACH_MAX_BYTES=15728640, WORKER_SESSION_POLL_INTERVAL_MS=30000.
# The proactive WhatsApp delay is the admin setting "Wait before the proactive WhatsApp delivery" (default 3 minutes);
# WORKER_WA_DELAY_MS (milliseconds, default 180000) is only the fallback while that setting is missing.
DOMAIN=@DOMAIN@
