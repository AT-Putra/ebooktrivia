# /etc/ebooktrivia/worker.env (0600, app user): the worker (apps/worker/src/worker-config.ts).
# UPTIME_KUMA_PUSH_URL: the Uptime Kuma push monitor URL (https). Fill it in, or leave it empty
# (`UPTIME_KUMA_PUSH_URL=`) while there is no Kuma; host-check.sh fails while __SET_ME__ is left.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL_WORKER=postgres://ebt_worker:@GEN@@postgres:5432/ebooktrivia
VALKEY_URL=redis://valkey:6379
VALKEY_USERNAME=worker
VALKEY_PASSWORD=@GEN@
BULLMQ_PREFIX=ebt
UPTIME_KUMA_PUSH_URL=__SET_ME__
