# /etc/ebooktrivia/worker.env (0600, app user): the worker (apps/worker/src/worker-config.ts).
# UPTIME_KUMA_PUSH_URL: the Uptime Kuma push monitor URL (https). Fill it in, or leave it empty
# (`UPTIME_KUMA_PUSH_URL=`) while there is no Kuma; host-check.sh fails while __SET_ME__ is left.
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL_WORKER=postgres://ebt_worker:@GEN@@postgres:5432/ebooktrivia
VALKEY_URL=redis://valkey:6379
VALKEY_USERNAME=worker
VALKEY_PASSWORD=@GEN@
BULLMQ_PREFIX=ebt
UPTIME_KUMA_PUSH_URL=__SET_ME__
# Sealed-secret private keys (base64url X25519), added by the Owner from escrow (provisioning does
# not generate them). The messaging key opens the SMTP password and WAHA API keys (template
# test-sends, US-017; deliveries, US-025); without it template test-sends are not relayed.
#   SECRETS_MESSAGING_PRIVATE_KEY=<base64url>
# The payment key opens the Midtrans server key: the worker re-queries Midtrans for every payment
# notification and runs the nightly reconciliation (US-021); without it no payment is confirmed.
#   SECRETS_PAYMENT_PRIVATE_KEY=<base64url>
