# infra/monitoring/glitchtip.env (0600, not committed). Copy this file, then replace every CHANGE_ME. One value per line, no quotes.
#
# SECRET_KEY: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
# The password of glitchtip-db-password.txt (the same value), URL-encoded if it has special characters (use hex: openssl rand -hex 24).
DATABASE_URL=postgres://glitchtip:CHANGE_ME@glitchtip-postgres:5432/glitchtip
# The public URL GlitchTip is reached at (through the box's reverse proxy), with the scheme.
GLITCHTIP_DOMAIN=https://glitchtip.example.com
# Where GlitchTip sends its own e-mail (alert e-mails, invitations): an SMTP URL, for example smtps://user:password@smtp.example.com:465
EMAIL_URL=CHANGE_ME
DEFAULT_FROM_EMAIL=glitchtip@example.com
# Registration is open until the Owner has made the first account; then set it to False and restart (docs/runbooks/monitoring.md, step 6).
ENABLE_USER_REGISTRATION=True
ENABLE_ORGANIZATION_CREATION=False
# The names the reverse proxy answers to, comma-separated (the default * accepts any Host).
ALLOWED_HOSTS=glitchtip.example.com
CSRF_TRUSTED_ORIGINS=https://glitchtip.example.com
# Events and issues are kept 30 days (the default is 90): the apps send no more than ids and masked text, and the box is shared.
GLITCHTIP_RETENTION_DAYS=30
