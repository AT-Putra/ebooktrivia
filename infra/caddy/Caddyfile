# Caddy 2.11.9 edge (plan M4.3). Rootless, socket-activated (infra/quadlet/caddy.socket):
#   fd/3 = TCP :80, fd/4 = TCP :443, both bound by systemd in the host network namespace, so every
#   connection keeps the real client address (podman's rootless port forwarding would replace it
#   with the container's own address; see docs/runbooks/staging-provision.md).
# The container has a pinned address on each network it shares with an app: 10.89.50.2 (public),
# 10.89.52.2 (admin), 10.89.53.2 (internal). Each app believes X-Forwarded-For from that address
# only (TRUSTED_PROXY_IP in its quadlet).
#
# Environment (infra/quadlet/caddy.container, EnvironmentFile /etc/ebooktrivia/caddy.env, written
# by infra/provision from provision.env; nothing in it is secret):
#   DOMAIN                   base domain: admin./play./order./api.{$DOMAIN}
#   ACME_EMAIL               ACME account contact
#   ADMIN_ALLOWED_CIDRS      space-separated; only these may reach admin.{$DOMAIN}
#   GLITCHTIP_ALLOWED_CIDRS  space-separated; only these may POST the GlitchTip hook
#   WAHA_ALLOWED_CIDRS       space-separated; only these may POST the WAHA webhook (/api/v1/webhooks/waha, US-025)
#   MONITOR_ALLOWED_CIDRS    space-separated; only these (the Uptime Kuma host) may GET api.{$DOMAIN}/healthz (US-015)
{
	# No admin endpoint: the config only changes by restarting the unit.
	admin off
	email {$ACME_EMAIL}
	# The :80 server is the explicit http:// site below (it is socket-activated, so Caddy cannot
	# open its own redirect listener).
	auto_https disable_redirects
	# TLS-ALPN-01 on fd/4 only. The HTTP-01 solver would want its own :80 listener inside the
	# container, which no traffic reaches.
	cert_issuer acme {
		disable_http_challenge
	}
	# Let's Encrypt no longer runs OCSP responders.
	ocsp_stapling off
	# LP domains: a certificate only for a host the internal process approves (an exact stored
	# lp_domains host, apps/worker/src/hosts.ts). internal:9000 is on ebt-internal, an internal
	# network it shares with Caddy only; no port of it is published.
	on_demand_tls {
		ask http://internal:9000/caddy/ask
	}
	servers {
		# The Host header must equal the TLS server name.
		strict_sni_host on
		protocols h1 h2
		# Caddy is the edge: no proxy in front of it is trusted, so X-Forwarded-For / X-Real-IP
		# from a client never become the client address (no trusted_proxies, no client_ip_headers).
		# Slow clients: 10 s for the headers, 30 s for a whole request body, 10 min to write a
		# response (a 100 MB PDF on a ~1.5 Mbit/s link). Caddy 2.11.9 has no per-route body timeout,
		# so admin uploads must fit one body in 30 s (chunked in the admin upload story, M5b).
		timeouts {
			read_header 10s
			read_body 30s
			write 10m
			idle 2m
		}
		max_header_size 64KB
	}
	# Caddy's own log (errors carry the request URI too): the same redaction as the access logs.
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "(?i)^/+(hooks/glitchtip|files)/.*$" "/$1/[redacted]"
			}
		}
	}
}

# Access log of every site. The GlitchTip hook token and signed-file tokens sit in the path and a
# signed URL's signature in the query, so every /hooks/glitchtip/ and /files/ URI (any case, any
# leading slashes) is replaced whole before the line is written. Cookies and Authorization go too.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "(?i)^/+(hooks/glitchtip|files)/.*$" "/$1/[redacted]"
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}

# Access log of the order origin (plan M6.6): the order's public id is a capability, so it never reaches a
# log line. The path of a page request (/{publicId}, or /order/{publicId} as the app's own route is
# spelled) becomes /[order], the Midtrans `order_id` query value (the dashboard's unfinish and error
# redirects, /?order_id={publicId}-{n}) is replaced, the Referer is not written (a page on another origin can
# link here with an id in its own URL), and neither are the response headers Next uses to report its
# rewrite (they name /order/{publicId}; the site also strips them from the response itself) or Location (an
# RSC request that Next redirects to /order/{publicId}?_rsc=... puts the id there). The hook and file
# patterns of access_log stay, and Cookie and Authorization go too.
(order_access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri multi_regexp {
					regexp "(?i)^/+(hooks/glitchtip|files)/.*$" "/$1/[redacted]"
					regexp "^/(order/)?[0-9A-Za-z]{16,40}.*$" "/[order]"
					regexp "order_id=[^&]*" "order_id=[redacted]"
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Referer delete
				resp_headers>X-Middleware-Rewrite delete
				resp_headers>X-Nextjs-Rewritten-Path delete
				resp_headers>X-Nextjs-Rewritten-Query delete
				resp_headers>Location delete
			}
		}
	}
}

(https) {
	bind fd/4 {
		protocols h1 h2
	}
}

# Headers on the app hosts. Set when the response is written (defer), so they replace the app's
# copies; CSP is added next to the app's nonce CSP (proxy.ts), and a browser enforces both.
(app_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		+Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
		-Server
		-X-Powered-By
	}
}

# The site's Referrer-Policy: every site emits exactly ONE (each site imports exactly one of these, and only these set
# the field; two blocks for one field did not combine in Caddy 2.11.9).
#   - FORCED on order.<domain> (AC-T5: vendor scripts run there): strict-origin, whatever the app or a bug sends;
#   - a DEFAULT elsewhere (`?`, US-031): it applies only when the app set none, so a route's own stricter policy reaches
#     the browser (no-referrer on the play login and trivia pages, same-origin on admin).
# infra/verify/local/security-headers.sh checks each route's value; order-headers.sh that the order one is forced.
(referrer_forced) {
	header {
		defer
		Referrer-Policy {args[0]}
	}
}

(referrer_default) {
	header {
		defer
		?Referrer-Policy {args[0]}
	}
}

# Upstream request headers. X-Forwarded-For is set to exactly the TCP peer (the real client); every
# other client-address header a client might send is removed before the request reaches an app.
(upstream_headers) {
	header_up X-Forwarded-For {remote_host}
	header_up -X-Real-IP
	header_up -Forwarded
	header_up -X-Client-IP
	header_up -True-Client-IP
	header_up -CF-Connecting-IP
	header_up -Fastly-Client-IP
	header_up -X-Cluster-Client-IP
}

# Idle pooled connections to the apps close after 30 s, before the apps' own keep-alive timeout
# (65 s, packages/edge), so a request is never sent on a connection the app is closing.
(upstream_transport) {
	transport http {
		keepalive 30s
	}
}

# public@a and public@b. Active health checks hit the shallow /livez of the edge listener
# (packages/edge); a draining instance answers 503 there for EDGE_DRAIN_MS (5 s) before it stops
# accepting, longer than health_interval + health_timeout. lb_try_duration retries a failed dial
# on the other instance.
(public_upstreams) {
	reverse_proxy public-a:3000 public-b:3000 {
		import upstream_headers
		import upstream_transport
		lb_policy round_robin
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 10s
		health_uri /livez
		health_interval 2s
		health_timeout 1s
		health_status 200
		health_fails 1
		health_passes 2
	}
}

# Blocked on every host: /internal (plan M4.3) and /livez (the load balancer's, checked on the
# upstreams directly, never through a site). Matched case-insensitively on the cleaned path.
# TRACE and TRACK are refused on every host before any app sees them (405; US-031, ASVS V13.4.4).
(blocked_paths) {
	@blocked path /internal /internal/* /livez /livez/*
	handle @blocked {
		respond 404
	}
	@trace method TRACE TRACK
	handle @trace {
		respond 405
	}
}

# The deep /healthz of the public app (US-015: PostgreSQL, the worker's heartbeat, Valkey) is the monitor's: only the api
# site serves it, and only to MONITOR_ALLOWED_CIDRS. On the play and order sites it is a 404 here, so it never reaches the
# app from there (the shallow /livez above is the load balancer's and is blocked everywhere).
(blocked_healthz) {
	@healthz path /healthz /healthz/*
	handle @healthz {
		respond 404
	}
}

# Port 80: redirect to HTTPS.
http:// {
	bind fd/3
	import access_log
	# US-031 (ASVS V4.1.2): only the pages people open in a browser are redirected. The API, its webhooks and the
	# signed files on api.<domain> answer 400 over plain HTTP: a server-to-server caller sending plaintext is told,
	# never silently upgraded (a 308 would keep the method and body).
	@api host api.{$DOMAIN}
	handle @api {
		respond "HTTPS only" 400
	}
	handle {
		redir https://{host}{uri} 308
	}
}

admin.{$DOMAIN} {
	import https
	import access_log
	import app_headers
	import referrer_default strict-origin-when-cross-origin
	import blocked_paths
	@outside not remote_ip {$ADMIN_ALLOWED_CIDRS}
	handle @outside {
		respond 404
	}
	handle {
		# Ebook PDFs go up to the 100 MiB hard cap of packages/uploads.
		request_body {
			max_size 110MB
		}
		reverse_proxy admin:3000 {
			import upstream_headers
			import upstream_transport
			# Retry a failed dial (admin restarting) like the public load balancer does.
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
}

play.{$DOMAIN} {
	import https
	import access_log
	import app_headers
	import referrer_default strict-origin-when-cross-origin
	import blocked_paths
	import blocked_healthz
	handle {
		request_body {
			max_size 1MB
		}
		import public_upstreams
	}
}

# The payment status page origin: vendor pixels run here, so it never carries cookies in either
# direction (plan M4.3).
order.{$DOMAIN} {
	import https
	import order_access_log
	import app_headers
	import referrer_forced strict-origin
	import blocked_paths
	import blocked_healthz
	request_header -Cookie
	# No Set-Cookie, and none of Next's rewrite headers: proxy.ts rewrites /{publicId} to /order/{publicId}
	# and Next 16 reports that rewrite to the client in x-middleware-rewrite (and, for an RSC request, in
	# x-nextjs-rewritten-path / -query), which would hand the public id to every log and cache on the way.
	header {
		defer
		-Set-Cookie
		-X-Middleware-Rewrite
		-X-Nextjs-Rewritten-Path
		-X-Nextjs-Rewritten-Query
	}
	handle {
		request_body {
			max_size 1MB
		}
		import public_upstreams
	}
}

api.{$DOMAIN} {
	import https
	import access_log
	import app_headers
	import referrer_default strict-origin-when-cross-origin
	import blocked_paths
	# The deep /healthz (US-015): only the monitor (Uptime Kuma) reaches the public app with it, for the path and anything under it;
	# every other source gets a 404 here.
	@healthz path /healthz /healthz/*
	handle @healthz {
		@monitor remote_ip {$MONITOR_ALLOWED_CIDRS}
		handle @monitor {
			import public_upstreams
		}
		handle {
			respond 404
		}
	}
	# The GlitchTip alert hook: only this exact path shape, only POST, only from the GlitchTip host,
	# goes to the internal process (which checks the token by its SHA-256). Anything else under
	# /hooks/glitchtip/ is a 404 here and never reaches an app.
	handle /hooks/glitchtip/* {
		@glitchtip {
			method POST
			path_regexp ^/hooks/glitchtip/[A-Za-z0-9_-]{16,512}$
			remote_ip {$GLITCHTIP_ALLOWED_CIDRS}
		}
		handle @glitchtip {
			request_body {
				max_size 64KB
			}
			reverse_proxy internal:9000 {
				import upstream_headers
			}
		}
		handle {
			respond 404
		}
	}
	# The WAHA webhook (US-025: message acks and the buyer-first inbound messages): only POST, only from the WAHA hosts, 64 KB max (the route's
	# own limit), to the public app. Its HMAC-SHA512 over the raw body is the authentication; this is the second lock, so a stranger cannot even
	# make the route verify a signature. From any other address the path is a 404 here and never reaches an app. WAHA_ALLOWED_CIDRS holds the
	# WAHA boxes' addresses as Caddy sees them (docs/runbooks/delivery.md: a WAHA on the internal network is seen from its network address).
	handle /api/v1/webhooks/waha {
		@waha {
			method POST
			remote_ip {$WAHA_ALLOWED_CIDRS}
		}
		handle @waha {
			request_body {
				max_size 64KB
			}
			import public_upstreams
		}
		handle {
			respond 404
		}
	}
	# The landing-page SDK (packages/sdk, US-019): static files that `infra/provision/build-images.sh
	# sdk` writes to /srv/sdk, served without a CDN. A versioned file (sdk-v1.2.3.js, and the Cap
	# widget cap-v0.1.62.js with its WebAssembly solvers cap-wasm-v0.0.8.wasm and
	# cap-hashwx-v0.0.8.wasm next to it) never changes, so it is cached for a year; the alias v1.js
	# moves with every v1 release, so it is cached for 5 minutes. The `file` matcher adds a header to
	# a file that exists only: a 404 for a version that is not deployed yet is never cached. The files are
	# public and carry no credentials, and a landing page on another origin must be able to read them:
	# the Cap widget fetch()es its WebAssembly (CORS), and a page with COEP require-corp can only embed
	# the script if it is marked cross-origin.
	handle_path /sdk/* {
		root * /srv/sdk
		header {
			Access-Control-Allow-Origin "*"
			Cross-Origin-Resource-Policy cross-origin
		}
		@immutable {
			path_regexp ^/(?:(?:sdk|cap)-v[0-9]+\.[0-9]+\.[0-9]+\.js|cap-(?:wasm|hashwx)-v[0-9]+\.[0-9]+\.[0-9]+\.wasm)$
			file {path}
		}
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@alias {
			path /v1.js
			file {path}
		}
		header @alias Cache-Control "public, max-age=300"
		encode zstd gzip
		file_server {
			hide .*
		}
	}
	handle {
		request_body {
			max_size 1MB
		}
		import public_upstreams
	}
}

# LP domains (any other host, US-023): on-demand certificates gated by the internal ask, which approves
# exactly the hosts of public.lp_served_hosts() (registered domains of ACTIVE landing pages hosted as a
# ZIP with a live version). Static files only, from /srv/lp/hosts/<host>/current: a relative symlink to
# ../../versions/<lpId>/<version>, switched by an atomic rename by the admin app
# (apps/admin/src/lib/settings/lp-hosting.ts), which also removes the host directory of a removed domain
# or an inactive page. Only lowercase stored-form hosts map to a directory (browsers send the host
# lowercased; anything else, including "..", is a 404 before a path is built).
#   - Only folder paths and the extensions an LP ZIP may hold (packages/uploads/src/lp-zip.ts
#     LP_FILE_TYPES) are served, each with its fixed Content-Type from the map below (charset=utf-8 on
#     text: the upload accepts UTF-8 only) and nosniff; any other path is a 404. A folder path serves its
#     index.html only. No directory listing,
#     no dot files, no templates / server-side includes: file_server only.
#   - Pages get a default CSP (docs/runbooks/landing-pages.md): scripts from the page itself (inline
#     too: the author's own static page), the SDK and Cap on api.<DOMAIN> ('wasm-unsafe-eval' for the
#     solver, blob: workers) and the three pixel vendors' script hosts; requests only to the page, the
#     API and the vendors' report hosts; forms post to the page only; never framed by another origin.
#     A page may tighten it with its own CSP (a browser enforces both).
#   - An SVG gets `sandbox` and no script at all when opened directly (it is also checked on upload).
https:// {
	import https
	import access_log
	tls {
		on_demand
	}
	header {
		defer
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	import blocked_paths
	@lp {
		method GET HEAD
		expression `{http.request.host}.matches("^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$")`
		path_regexp lpfile (?i)(?:/[^/.]*|\.(?:html?|css|m?js|json|map|txt|svg|png|jpe?g|gif|webp|avif|ico|woff2?|ttf|otf|mp4|webm))$
	}
	handle @lp {
		root * /srv/lp/hosts/{http.request.host}/current
		map {path} {lp_content_type} {
			~(?i)\.html?$ "text/html; charset=utf-8"
			~(?i)\.css$ "text/css; charset=utf-8"
			~(?i)\.m?js$ "text/javascript; charset=utf-8"
			~(?i)\.(?:json|map)$ application/json
			~(?i)\.txt$ "text/plain; charset=utf-8"
			~(?i)\.svg$ image/svg+xml
			~(?i)\.png$ image/png
			~(?i)\.jpe?g$ image/jpeg
			~(?i)\.gif$ image/gif
			~(?i)\.webp$ image/webp
			~(?i)\.avif$ image/avif
			~(?i)\.ico$ image/x-icon
			~(?i)\.woff$ font/woff
			~(?i)\.woff2$ font/woff2
			~(?i)\.ttf$ font/ttf
			~(?i)\.otf$ font/otf
			~(?i)\.mp4$ video/mp4
			~(?i)\.webm$ video/webm
			default "text/html; charset=utf-8"
		}
		header Content-Type {lp_content_type}
		@svg path_regexp (?i)\.svg$
		header @svg Content-Security-Policy "sandbox; default-src 'none'; img-src data:; style-src 'unsafe-inline'"
		@page not path_regexp (?i)\.svg$
		header @page Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://api.{$DOMAIN} https://connect.facebook.net https://analytics.tiktok.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://api.{$DOMAIN} https://www.facebook.com https://connect.facebook.net https://analytics.tiktok.com https://analytics-ipv6.tiktokw.us https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.google.com https://www.google.co.id https://ad.doubleclick.net; worker-src blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
		encode zstd gzip
		# index.html only: a folder holding just an index.txt (or another index.* Caddy would try) is a
		# 404, never served under the folder path's text/html type (security review US-023 M1).
		file_server {
			hide .*
			index index.html
		}
	}
	handle {
		respond 404
	}
}
