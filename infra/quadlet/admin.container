# Admin app (admin.<domain>), behind Caddy. On its own internal network with Caddy only
# (ebt-admin) and listening on that address only, so the admin IP allowlist in the Caddyfile cannot
# be bypassed from another container (review S2). Same edge listener as public: /livez, drain,
# X-Forwarded-For from Caddy's 10.89.52.2 only (the admin login rate limit keys on it). Mounts all
# of /srv/data: it writes the ebook files (deliverables), imports and proofs.
[Unit]
Description=ebooktrivia admin app
Wants=postgres.service valkey.service
After=postgres.service valkey.service

[Container]
Image=localhost/ebooktrivia/admin:current
Pull=never
ContainerName=admin
Network=ebt-admin.network:ip=10.89.52.13
Network=ebt-data.network:ip=10.89.51.13
EnvironmentFile=/etc/ebooktrivia/admin.env
Environment=EDGE_HOST=10.89.52.13 TRUSTED_PROXY_IP=10.89.52.2 EDGE_PORT=3000 EDGE_DRAIN_MS=5000 EDGE_CLOSE_TIMEOUT_MS=15000
Environment=NODE_OPTIONS=--max-old-space-size=384
UserNS=keep-id:uid=1000,gid=1000
Volume=/srv/data:/srv/data:z
Tmpfs=/app/apps/admin/.next/cache:rw,size=64m,mode=1777
# bash, not curl (the image has none); the address it listens on.
HealthCmd=bash -c 'exec 3<>/dev/tcp/10.89.52.13/3000 && printf "GET /livez HTTP/1.0\r\n\r\n" >&3 && head -1 <&3 | grep -q " 200 "'
HealthInterval=2s
HealthTimeout=2s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy
LogDriver=journald
Memory=600m
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
StopTimeout=30

[Service]
Restart=always
TimeoutStartSec=120
TimeoutStopSec=40

[Install]
WantedBy=default.target
