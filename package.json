{
  "name": "ebooktrivia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --workspace-concurrency=4 run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:i18n": "tsx scripts/check-i18n.ts packages/i18n/messages"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "ts7": "npm:typescript@7.0.2",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
