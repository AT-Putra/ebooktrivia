{
  "name": "@ebooktrivia/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "start:internal": "node src/main.ts --role=internal",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:chaos": "vitest run --config vitest.int.config.ts test/chaos.int.test.ts test/caddy-load.int.test.ts test/prod-valkey-acl.int.test.ts"
  },
  "dependencies": {
    "@ebooktrivia/adapters": "workspace:*",
    "@ebooktrivia/core": "workspace:*",
    "@ebooktrivia/crypto": "workspace:*",
    "@ebooktrivia/db": "workspace:*",
    "@hono/node-server": "2.1.6",
    "bullmq": "6.7.5",
    "hono": "4.13.17",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "postgres": "4.1.0"
  }
}
