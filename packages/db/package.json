{
  "name": "@ebooktrivia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/connection.ts",
    "./health": "./src/health.ts",
    "./migrate": "./src/migrate.ts",
    "./login-role": "./src/login-role.ts",
    "./login-throttle": "./src/login-throttle.ts",
    "./secrets": "./src/secrets.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "auth:ddl": "tsx scripts/better-auth-ddl.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "better-auth": "1.7.19",
    "drizzle-kit": "0.31.11",
    "kysely": "0.28.17",
    "pg": "8.23.1"
  }
}
